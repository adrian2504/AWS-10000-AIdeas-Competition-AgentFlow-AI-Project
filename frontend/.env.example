# AgentFlow Frontend Configuration
# Copy this file to .env and fill in your values from CDK deployment

# API Gateway endpoint (from CDK output: APIEndpoint)
REACT_APP_API_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod

# Cognito User Pool ID (from CDK output: UserPoolId)
REACT_APP_USER_POOL_ID=us-east-1_xxxxxxxxx

# Cognito User Pool Client ID (from CDK output: UserPoolClientId)
REACT_APP_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS Region (should match your deployment region)
REACT_APP_AWS_REGION=us-east-1
